{{- /*
  RSS feeds (home, sections, terms): Hugo 0.168.0's embedded rss.xml (tpl/tplimpl/embedded/templates/rss.xml) with
  seven changes: the home feed lists only pages in the site's main sections (site.MainSections, the same pages as the
  walls), so About, Archive and Search stay out (#18), and so does a term's feed (tag, category, series; the same pages
  as the term's wall, #322; a section's feed lists the section's own pages); items use page-title.html, so an untitled post gets a title
  (#18); an item without a date has no pubDate instead of "01 Jan 0001" (#36); lastBuildDate comes from the listed
  items only, and is left out when there are none or none is dated (#68); items are sorted by publish date, newest
  first, before the limit is applied, so a post's weight (the series order, README) can't put older posts first or push
  newer ones out of a limited feed (#163; a taxonomy's feed of terms keeps Hugo's order); and an item's summary loses the
  aria-describedby="tb-newtab" that render-link.html puts on links to other hosts, since the notice it points at is in
  baseof.html's pages and not in a feed. Compare with the embedded template when upgrading Hugo. The channel's title
  and description are the site's language (i18n, #192). A site's own home.rss.xml still takes precedence for the home feed.
*/ -}}
{{- $authorEmail := "" }}
{{- with site.Params.author }}
	{{- if reflect.IsMap . }}
		{{- with .email }}
			{{- $authorEmail = . }}
		{{- end }}
	{{- end }}
{{- end }}

{{- $authorName := "" }}
{{- with site.Params.author }}
	{{- if reflect.IsMap . }}
		{{- with .name }}
			{{- $authorName = . }}
		{{- end }}
	{{- else }}
		{{- $authorName = . }}
	{{- end }}
{{- end }}

{{- $pctx := . }}
{{- if .IsHome }}{{ $pctx = .Site }}{{ end }}
{{- $pages := slice }}
{{- if or $.IsHome $.IsSection }}
	{{- $pages = $pctx.RegularPages }}
{{- else }}
	{{- $pages = $pctx.Pages }}
{{- end }}
{{- if .IsHome }}{{ $pages = where $pages "Section" "in" site.MainSections }}{{ end }}
{{- /* A term's feed lists the pages its wall lists (term.html): the term's pages in the main sections. */}}
{{- if eq .Kind "term" }}{{ $pages = where .RegularPages "Section" "in" site.MainSections }}{{ end }}
{{- /* A taxonomy's own feed lists its terms, which have no dates of their own, so it keeps Hugo's order. */}}
{{- if ne .Kind "taxonomy" }}{{ $pages = $pages.ByPublishDate.Reverse }}{{ end }}
{{- $limit := .Site.Config.Services.RSS.Limit }}
{{- if ge $limit 1 }}
	{{- $pages = $pages | first $limit }}
{{- end }}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
	<channel>
		<title>{{ if eq .Title .Site.Title }}{{ .Site.Title }}{{ else }}{{ with .Title }}{{ (or (T "feedTitle" (dict "title" . "site" $.Site.Title)) (partial "t.html" (slice "feedTitle" (dict "title" . "site" $.Site.Title)))) }}{{ else }}{{ .Site.Title }}{{ end }}{{ end }}</title>
		<link>{{ .Permalink }}</link>
		<description>{{ if and .Title (ne .Title .Site.Title) }}{{ (or (T "feedDescriptionIn" (dict "title" .Title "site" .Site.Title)) (partial "t.html" (slice "feedDescriptionIn" (dict "title" .Title "site" .Site.Title)))) }}{{ else }}{{ (or (T "feedDescription" (dict "site" .Site.Title)) (partial "t.html" (slice "feedDescription" (dict "site" .Site.Title)))) }}{{ end }}</description>
		<generator>Hugo</generator>
		<language>{{ site.Language.Locale }}</language>
		{{ with $authorEmail }}
			<managingEditor>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</managingEditor>
		{{ end }}
		{{ with $authorEmail }}
			<webMaster>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</webMaster>
		{{ end }}
		{{ with .Site.Copyright }}
			<copyright>{{ . }}</copyright>
		{{ end }}
		{{ with $pages }}{{ $last := (index .ByLastmod.Reverse 0).Lastmod }}{{ if not $last.IsZero }}
			<lastBuildDate>{{ $last.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
		{{ end }}{{ end }}
		{{- with .OutputFormats.Get "RSS" }}
			{{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
		{{- end }}
		{{- range $pages }}
			<item>
				<title>{{ partial "page-title.html" . }}</title>
				<link>{{ .Permalink }}</link>
				{{- if not .PublishDate.IsZero }}
				<pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
				{{- end }}
				{{- with $authorEmail }}<author>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</author>{{ end }}
				<guid>{{ .Permalink }}</guid>
				<description>{{ .Summary | replaceRE ` aria-describedby="tb-newtab"` "" | transform.XMLEscape | safeHTML }}</description>
			</item>
		{{- end }}
	</channel>
</rss>
